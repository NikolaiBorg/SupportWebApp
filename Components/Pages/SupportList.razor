@page "/support-list"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<PageTitle>Supporthenvendelser</PageTitle>

<h1>Supporthenvendelser</h1>

@if (messages == null)
{
    <p>Indlæser henvendelser...</p>
}
else if (messages.Count == 0)
{
    <p>Der er ingen supporthenvendelser.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Navn</th>
            <th>Email</th>
            <th>Telefon</th>
            <th>Kategori</th>
            <th>Beskrivelse</th>
            <th>Dato</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var message in messages)
        {
            <tr>
                <td>@message.Navn</td>
                <td>@message.Email</td>
                <td>@message.Telefon</td>
                <td>@message.Category</td>
                <td>@message.Beskrivelse</td>
                <td>@message.DatoTidspunkt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private List<SupportMessage>? messages;

    protected override async Task OnInitializedAsync()
    {
        messages = await CosmosDbService.GetSupportMessagesAsync();
    }
}