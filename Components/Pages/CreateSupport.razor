@page "/create-support"
@rendermode InteractiveServer

@using SupportWebApp.Models
@using SupportWebApp.Services
@inject CosmosDbService CosmosDbService

<PageTitle>Opret supporthenvendelse</PageTitle>

<h1>Opret supporthenvendelse</h1>

<EditForm Model="@supportMessage" OnValidSubmit="@CreateMessage">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Navn</label>
        <InputText class="form-control" @bind-Value="supportMessage.Navn" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="supportMessage.Email" />
    </div>

    <div class="mb-3">
        <label>Telefon</label>
        <InputText class="form-control" @bind-Value="supportMessage.Telefon" />
    </div>

    <div class="mb-3">
        <label>Kategori</label>
        <InputSelect class="form-control" @bind-Value="supportMessage.Category">
            <option value="">Vælg kategori</option>
            <option value="salg">Salg</option>
            <option value="reservedele">Reservedele</option>
            <option value="forhandler">Forhandler</option>
            <option value="forslag">Forslag</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Beskrivelse</label>
        <InputTextArea class="form-control" @bind-Value="supportMessage.Beskrivelse" />
    </div>

    <button type="submit" class="btn btn-primary">Opret henvendelse</button>
</EditForm>

@if (messageCreated)
{
    <div class="alert alert-success mt-3">
        Henvendelsen er oprettet.
    </div>
}

@code {
    private SupportMessage supportMessage = new();
    private bool messageCreated = false;

    private async Task CreateMessage()
    {
        await CosmosDbService.CreateSupportMessageAsync(supportMessage);

        messageCreated = true;
        supportMessage = new SupportMessage();
    }
}